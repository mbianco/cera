{
  "name": "cera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agent for climate scientists on the Alps supercomputer, built on DeepSeek Harness (dsh)",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"tests/integration/**\" --exclude \"tests/property/**\"",
    "test:slow": "vitest run --exclude \"tests/integration/**\"",
    "test:full": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "^10.0.1",
    "fast-check": "^4.10.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {}
  }
}
